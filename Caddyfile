# Production site. Build with Hugo before starting Caddy.
{
  admin off
  auto_https disable_redirects
}
http://lbry.com {
  redir https://lbry.com{uri} 301
}
https://lbry.com {
  root * {$SITE_ROOT:./public}
  route {
    # Shared policies; assets cache longer, errors override caching below.
    header {
      Cache-Control "public, max-age=300"
      Content-Security-Policy "frame-ancestors 'none'"
      X-Frame-Options "DENY"
      Strict-Transport-Security "max-age=31536000"
      X-Content-Type-Options "nosniff"
    }
    @assets path_regexp assets `(?i)[.](?:css|js|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot|pdf|zip|apk|exe|dmg|deb|appimage)$`
    header @assets Cache-Control "public, max-age=14400"

    @unsupported not method GET HEAD
    handle @unsupported {
      header Allow "GET, HEAD"
      header Cache-Control "private, no-cache"
      header Content-Type "text/html;charset=UTF-8"
      method GET
      rewrite * /405/index.html
      file_server {
        status 405
      }
    }

    # Never expose internal files left in an old build directory.
    @internal path_regexp internal `^/_[^/]*(?:/|$)`
    handle @internal {
      header Cache-Control "private, no-cache"
      header Content-Type "text/html;charset=UTF-8"
      rewrite * /404/index.html
      file_server {
        status 404
      }
    }

    vars original_path {http.request.uri.path}
    map {query} {query_suffix} {
      "" ""
      default "?{query}"
    }
    # One leading slash and no trailing slash, except for the root URL.
    uri path_regexp /+ /
    uri path_regexp ^(.+?)/+$ $1

    # Exact files keep their spelling. Other paths try lowercase URLs.
    @needs_lowercase {
      path_regexp uppercase_path [A-Z]
      not file {path}/index.html {path}
    }
    route @needs_lowercase {
      uri path_regexp A a
      uri path_regexp B b
      uri path_regexp C c
      uri path_regexp D d
      uri path_regexp E e
      uri path_regexp F f
      uri path_regexp G g
      uri path_regexp H h
      uri path_regexp I i
      uri path_regexp J j
      uri path_regexp K k
      uri path_regexp L l
      uri path_regexp M m
      uri path_regexp N n
      uri path_regexp O o
      uri path_regexp P p
      uri path_regexp Q q
      uri path_regexp R r
      uri path_regexp S s
      uri path_regexp T t
      uri path_regexp U u
      uri path_regexp V v
      uri path_regexp W w
      uri path_regexp X x
      uri path_regexp Y y
      uri path_regexp Z z
    }
    vars request_path {http.request.uri.path}

