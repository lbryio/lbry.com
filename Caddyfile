    @article_alias {
      expression `{article_redirect_target} != "" && {article_redirect_target} != {http.vars.request_path}`
      file {article_redirect_target}/index.html
    }
    redir @article_alias {article_redirect_target}{query_suffix} 301

    @downloads path_regexp downloads `^/(?:releases/(?:pre/)?[^/]+[.][^/]+|get/.+)$`
    redir @downloads /get 301
    @bounty path_regexp bounty `^/bounty/.*$`
    redir @bounty https://lbry.tech/contribute 302
    @roadmap path_regexp roadmap `^/roadmap/.*$`
    redir @roadmap /roadmap 302

    # Retained static replacements for former dynamic URL families.
    @list_action path_regexp list_action `^/list/(?:confirm|edit|unsubscribe)/[^/]+$`
    rewrite @list_action /list/subscribe
    @dmca_action path_regexp dmca_action `^/dmca/[^/]+$`
    rewrite @dmca_action /dmca
    @youtube_status path_regexp youtube_status `^/youtube/status/[^/]+$`
    rewrite @youtube_status /youtube/status/migration-public-reference
    @news_category path_regexp news_category `^/news/category/[^/]+$`
    rewrite @news_category /news/category/migration-public-reference

    @page_or_asset file {path}/index.html {path}
    handle @page_or_asset {
      # Normalization is public only when an actual destination exists.
      @normalized expression `{http.vars.original_path} != {http.vars.request_path}`
      redir @normalized {http.vars.request_path}{query_suffix} 301
      @team_filename path /team/*.md
      header @team_filename Content-Type "text/html;charset=UTF-8"
      try_files {path}/index.html {path}
      file_server {
        disable_canonical_uris
      }
    }
    handle {
      header Cache-Control "private, no-cache"
      header Content-Type "text/html;charset=UTF-8"
      rewrite * /404/index.html
      file_server {
        status 404
      }
    }
  }
